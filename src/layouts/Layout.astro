---
// src/layouts/Layout.astro
import Background from '../components/Background.astro';
import faviconImg from '../assets/ATRIA_favicon_32x32.png';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={faviconImg.src} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <Background />
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg-main: #F4F6F8;
    --card-bg: #FFFFFF;
    --primary-blue: #0F2537;       /* Azul Profundo */
    --accent-gold: #C7A96A;        /* Dorado */
    --gray-balance: #6B7280;       /* Gris Equilibrio */
    --gray-light: #E5E7EB;         /* Gris Claro */
    --text-primary: #0F2537;
    --text-secondary: #4B5563;
    --border-subtle: rgba(15, 37, 55, 0.08);
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--text-secondary);
    background-color: var(--bg-main);
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    background: transparent;
    overflow-x: hidden;
  }

  .container {
    width: 90% !important;
    max-width: 1240px !important;
    margin: 0 auto !important;
  }

  .code-font {
    font-family: 'JetBrains Mono', monospace;
  }
</style>