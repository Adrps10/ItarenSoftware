---
// src/components/Hero.astro
---

<section class="atria-hero-container">
  <div class="spotlight-gold"></div>

  <div class="container hero-content">
    <div class="launch-pill">
      <span class="pulse-beam"></span>
      <span class="pill-txt">Arquitectura Cloud &bull; Flutter &bull; Sistemas Críticos</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </div>

    <h1 class="hero-headline">
      Software de nivel industrial.<br />
      <span class="hero-gradient-txt">Diseñado para liderar tu sector.</span>
    </h1>

    <p class="hero-subline">
      Construimos la infraestructura digital que escala agencias, comercializadoras y corporativos. Control total de inventarios, CRM, puntos de venta y apps móviles integradas sin fricción.
    </p>

    <div class="hero-actions">
      <a href="#cotizador" class="btn-primary-atria">
        <span>Cotizar mi solución</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="#proyectos" class="btn-secondary-atria">Ver casos de estudio</a>
    </div>

    <div class="metrics-ribbon">
      <div class="metric-pill">
        <span class="m-val">+40%</span>
        <span class="m-lbl">Eficiencia Operativa</span>
      </div>
      <div class="metric-sep"></div>
      <div class="metric-pill">
        <span class="m-val">Multi-Sucursal</span>
        <span class="m-lbl">Sincronización Cloud</span>
      </div>
      <div class="metric-sep"></div>
      <div class="metric-pill">
        <span class="m-val">iOS & Android</span>
        <span class="m-lbl">Despliegue Nativo</span>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .atria-hero-container {
    position: relative;
    padding: 5rem 0 5.5rem;
    display: flex;
    justify-content: center;
    overflow: hidden;
    background: transparent;
  }

  .spotlight-gold {
    position: absolute;
    top: -25%;
    left: 50%;
    transform: translateX(-50%);
    width: 75vw;
    height: 520px;
    background: radial-gradient(ellipse at center, rgba(199, 169, 106, 0.16) 0%, rgba(15, 37, 55, 0.04) 55%, transparent 75%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .launch-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: #FFFFFF;
    border: 1px solid rgba(15, 37, 55, 0.1);
    padding: 0.45rem 1.3rem;
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 700;
    color: #0F2537;
    margin-bottom: 1.8rem;
    box-shadow: 0 4px 15px rgba(15, 37, 55, 0.04);
  }

  .pulse-beam {
    width: 8px;
    height: 8px;
    background: #C7A96A;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(199, 169, 106, 0.7);
    animation: beam 2s infinite;
  }

  @keyframes beam {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(199, 169, 106, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(199, 169, 106, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(199, 169, 106, 0); }
  }

  .hero-headline {
    font-size: clamp(2.6rem, 5.2vw, 4.4rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -2px;
    color: #0F2537;
    max-width: 960px;
    margin-bottom: 1.4rem;
  }

  /* GRADIENTE CORPORATIVO AZUL PROFUNDO A DORADO */
  .hero-gradient-txt {
    background: linear-gradient(135deg, #0F2537 15%, #C7A96A 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
  }

  .hero-subline {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.7;
    color: #6B7280;
    max-width: 700px;
    margin-bottom: 2.5rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-bottom: 3rem;
  }

  .btn-primary-atria {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #0F2537;
    color: #FFFFFF !important;
    text-decoration: none !important;
    font-weight: 800;
    padding: 1.05rem 2.4rem;
    border-radius: 12px;
    border: 1px solid rgba(199, 169, 106, 0.35);
    box-shadow: 0 8px 22px rgba(15, 37, 55, 0.22);
    transition: all 0.25s ease;
  }

  .btn-primary-atria:hover {
    transform: translateY(-2px);
    background: #C7A96A;
    color: #0F2537 !important;
    border-color: #C7A96A;
  }

  .btn-secondary-atria {
    display: inline-block;
    padding: 1.05rem 2.4rem;
    background: #FFFFFF;
    border: 1.5px solid rgba(15, 37, 55, 0.12);
    border-radius: 12px;
    color: #0F2537 !important;
    text-decoration: none !important;
    font-weight: 700;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.03);
    transition: all 0.25s ease;
  }

  .btn-secondary-atria:hover {
    background: #F4F6F8;
    border-color: #C7A96A;
  }

  .metrics-ribbon {
    display: flex;
    align-items: center;
    gap: 2.2rem;
    background: #FFFFFF;
    border: 1px solid rgba(15, 37, 55, 0.08);
    padding: 0.75rem 2rem;
    border-radius: 9999px;
    box-shadow: 0 4px 15px rgba(15, 37, 55, 0.04);
  }

  @media (max-width: 768px) {
    .metrics-ribbon { flex-direction: column; gap: 0.9rem; border-radius: 18px; padding: 1.25rem; }
    .metric-sep { display: none; }
  }

  .metric-pill { display: flex; align-items: baseline; gap: 8px; }
  .m-val { font-size: 1.15rem; font-weight: 900; color: #0F2537; }
  .m-lbl { font-size: 0.76rem; font-weight: 700; color: #C7A96A; text-transform: uppercase; }
  .metric-sep { width: 1px; height: 18px; background: rgba(15, 37, 55, 0.1); }
</style>