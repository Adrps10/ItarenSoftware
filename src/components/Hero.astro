---
// src/components/Hero.astro
---

<section class="apple-hero-container">
  <div class="spotlight-stage"></div>

  <div class="container hero-content">
    <div class="launch-pill">
      <span class="pulse-beam"></span>
      <span class="pill-txt">Arquitectura Cloud &bull; Flutter &bull; Sistemas Críticos</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </div>

    <h1 class="hero-headline">
      Software de nivel industrial.<br />
      <span class="hero-gradient-txt">Diseñado para liderar tu sector.</span>
    </h1>

    <p class="hero-subline">
      Construimos la infraestructura digital que escala agencias, comercializadoras y corporativos. Control total de inventarios, CRM, puntos de venta y apps móviles integradas sin fricción.
    </p>

    <div class="hero-actions">
      <a href="#cotizador" class="btn-primary-blue">
        <span>Cotizar mi solución</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="#proyectos" class="btn-secondary-white">Ver casos de estudio</a>
    </div>

    <div class="metrics-ribbon">
      <div class="metric-pill">
        <span class="m-val">+40%</span>
        <span class="m-lbl">Eficiencia Operativa</span>
      </div>
      <div class="metric-sep"></div>
      <div class="metric-pill">
        <span class="m-val">Multi-Sucursal</span>
        <span class="m-lbl">Sincronización Cloud</span>
      </div>
      <div class="metric-sep"></div>
      <div class="metric-pill">
        <span class="m-val">iOS & Android</span>
        <span class="m-lbl">Despliegue Nativo</span>
      </div>
    </div>

    <!-- PRODUCT CANVAS STRIPE CLEAN -->
    <div class="showcase-viewport">
      <div class="floating-badge badge-left">
        <div class="badge-icon-box success">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <div class="badge-info">
          <span class="b-title">Sincronización Exitosa</span>
          <span class="b-sub">1,240 registros / 0.12s</span>
        </div>
      </div>

      <div class="floating-badge badge-right">
        <div class="badge-icon-box star">★</div>
        <div class="badge-info">
          <span class="b-title">Satisfacción CSAT</span>
          <span class="b-sub">98.8% &bull; Calificación 5.0</span>
        </div>
      </div>

      <div class="macbook-glass-frame">
        <div class="mac-header">
          <div class="window-controls">
            <span class="win-btn close"></span>
            <span class="win-btn min"></span>
            <span class="win-btn max"></span>
          </div>
          <div class="tab-indicator code-font">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/></svg>
            itaren-enterprise-os.app &mdash; Dashboard Maestro
          </div>
          <div class="live-status-chip">
            <span class="chip-dot"></span> PRODUCCIÓN LIVE
          </div>
        </div>

        <div class="mac-body">
          <div class="dash-top-row">
            <div class="dash-kpi-card">
              <span class="kpi-label">Ingresos Diarios Globales</span>
              <span class="kpi-value counter-sales">$148,920 MXN</span>
              <span class="kpi-tag positive">&uarr; +32.4% vs mes anterior</span>
            </div>
            <div class="dash-kpi-card">
              <span class="kpi-label">Transacciones POS Activas</span>
              <span class="kpi-value counter-pos">842 Operaciones</span>
              <span class="kpi-tag blue-tag">Multi-Sucursal Conectada</span>
            </div>
          </div>

          <div class="dash-graph-card">
            <div class="graph-top">
              <div>
                <h4>Rendimiento de Operaciones</h4>
                <p>Carga de trabajo y transacciones en tiempo real</p>
              </div>
              <span class="graph-pill code-font">LATENCIA: 42ms</span>
            </div>

            <div class="frequency-bars">
              <div class="f-col"><div class="f-bar" style="height: 40%"></div><span>08:00</span></div>
              <div class="f-col"><div class="f-bar" style="height: 65%"></div><span>10:00</span></div>
              <div class="f-col"><div class="f-bar" style="height: 50%"></div><span>12:00</span></div>
              <div class="f-col"><div class="f-bar highlight" style="height: 96%"></div><span>14:00</span></div>
              <div class="f-col"><div class="f-bar" style="height: 75%"></div><span>16:00</span></div>
              <div class="f-col"><div class="f-bar" style="height: 85%"></div><span>18:00</span></div>
              <div class="f-col"><div class="f-bar" style="height: 55%"></div><span>20:00</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .apple-hero-container {
    position: relative;
    padding: 6.5rem 0 7.5rem;
    display: flex;
    justify-content: center;
    overflow: hidden;
    background: transparent;
  }

  .spotlight-stage {
    position: absolute;
    top: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: 80vw;
    height: 600px;
    background: radial-gradient(ellipse at center, rgba(37, 99, 235, 0.12) 0%, rgba(16, 185, 129, 0.05) 50%, transparent 75%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .launch-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.08);
    padding: 0.5rem 1.4rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 700;
    color: #0F172A;
    margin-bottom: 2rem;
    box-shadow: 0 4px 15px rgba(15, 23, 42, 0.04);
  }

  .pulse-beam {
    width: 8px;
    height: 8px;
    background: #10B981;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: beam 2s infinite;
  }

  @keyframes beam {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  .hero-headline {
    font-size: clamp(2.8rem, 5.8vw, 4.8rem);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -2px;
    color: #0F172A;
    max-width: 960px;
    margin-bottom: 1.6rem;
  }

  .hero-gradient-txt {
    background: linear-gradient(135deg, #2563EB 0%, #0F172A 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subline {
    font-size: clamp(1.1rem, 1.8vw, 1.25rem);
    line-height: 1.7;
    color: #475569;
    max-width: 720px;
    margin-bottom: 2.8rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 3.5rem;
  }

  .btn-primary-blue {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #2563EB;
    color: #FFFFFF !important;
    text-decoration: none !important;
    font-weight: 800;
    padding: 1.15rem 2.5rem;
    border-radius: 14px;
    box-shadow: 0 10px 25px rgba(37, 99, 235, 0.3);
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  .btn-primary-blue:hover {
    transform: translateY(-3px);
    background: #1d4ed8;
  }

  .btn-secondary-white {
    display: inline-block;
    padding: 1.15rem 2.5rem;
    background: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 14px;
    color: #0F172A !important;
    text-decoration: none !important;
    font-weight: 700;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.03);
    transition: all 0.25s ease;
  }

  .btn-secondary-white:hover {
    background: #F1F5F9;
    border-color: #2563EB;
  }

  .metrics-ribbon {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    margin-bottom: 4rem;
    background: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.06);
    padding: 0.8rem 2.2rem;
    border-radius: 9999px;
    box-shadow: 0 4px 15px rgba(15, 23, 42, 0.03);
  }

  @media (max-width: 768px) {
    .metrics-ribbon { flex-direction: column; gap: 1rem; border-radius: 20px; padding: 1.5rem; }
    .metric-sep { display: none; }
  }

  .metric-pill { display: flex; align-items: baseline; gap: 8px; }
  .m-val { font-size: 1.15rem; font-weight: 900; color: #0F172A; }
  .m-lbl { font-size: 0.78rem; font-weight: 700; color: #64748B; text-transform: uppercase; }
  .metric-sep { width: 1px; height: 20px; background: rgba(15, 23, 42, 0.08); }

  .showcase-viewport {
    position: relative;
    width: 100%;
    max-width: 1040px;
  }

  .floating-badge {
    position: absolute;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(15, 23, 42, 0.08);
    padding: 0.85rem 1.4rem;
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08);
    backdrop-filter: blur(16px);
  }

  .badge-left { top: 20%; left: -30px; }
  .badge-right { bottom: 25%; right: -30px; }

  @media (max-width: 1024px) {
    .badge-left, .badge-right { display: none; }
  }

  .badge-icon-box {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-weight: 900;
  }
  .badge-icon-box.success { background: #10B981; }
  .badge-icon-box.star { background: #2563EB; }

  .badge-info { display: flex; flex-direction: column; text-align: left; }
  .b-title { font-size: 0.85rem; font-weight: 800; color: #0F172A; }
  .b-sub { font-size: 0.72rem; color: #64748B; }

  .macbook-glass-frame {
    background: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 24px;
    box-shadow: 0 30px 60px -15px rgba(15, 23, 42, 0.08);
    overflow: hidden;
  }

  .mac-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.8rem;
    background: #F8FAFC;
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
  }

  .window-controls { display: flex; gap: 7px; }
  .win-btn { width: 11px; height: 11px; border-radius: 50%; background: #E2E8F0; }
  .win-btn.close { background: #ef4444; }
  .win-btn.min { background: #f59e0b; }
  .win-btn.max { background: #10b981; }

  .tab-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    color: #64748B;
    font-weight: 600;
  }

  .live-status-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    color: #10B981;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.2);
    padding: 3px 10px;
    border-radius: 9999px;
    font-weight: 800;
  }
  .chip-dot { width: 6px; height: 6px; background: #10B981; border-radius: 50%; }

  .mac-body {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .dash-top-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 650px) {
    .dash-top-row { grid-template-columns: 1fr; }
  }

  .dash-kpi-card {
    background: #F8FAFC;
    border: 1px solid rgba(15, 23, 42, 0.06);
    border-radius: 18px;
    padding: 1.6rem;
    text-align: left;
  }

  .kpi-label { font-size: 0.82rem; color: #64748B; font-weight: 600; display: block; margin-bottom: 0.4rem; }
  .kpi-value { font-size: 2rem; font-weight: 900; color: #0F172A; display: block; margin-bottom: 0.5rem; }
  
  .kpi-tag { font-size: 0.78rem; font-weight: 700; }
  .kpi-tag.positive { color: #10B981; }
  .kpi-tag.blue-tag { color: #2563EB; }

  .dash-graph-card {
    background: #F8FAFC;
    border: 1px solid rgba(15, 23, 42, 0.06);
    border-radius: 18px;
    padding: 1.8rem;
  }

  .graph-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    text-align: left;
  }
  .graph-top h4 { font-size: 1rem; font-weight: 800; color: #0F172A; margin-bottom: 0.2rem; }
  .graph-top p { font-size: 0.82rem; color: #64748B; margin: 0; }

  .graph-pill {
    font-size: 0.72rem;
    color: #2563EB;
    background: #FFFFFF;
    border: 1px solid rgba(37, 99, 235, 0.2);
    padding: 4px 10px;
    border-radius: 8px;
    font-weight: 700;
  }

  .frequency-bars {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    height: 110px;
    gap: 12px;
  }

  .f-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex: 1;
    height: 100%;
    justify-content: flex-end;
  }
  .f-col span { font-size: 0.72rem; color: #64748B; font-weight: 600; }

  .f-bar {
    width: 100%;
    max-width: 32px;
    background: #E2E8F0;
    border-radius: 8px;
  }

  .f-bar.highlight {
    background: linear-gradient(180deg, #2563EB 0%, #10B981 100%);
    box-shadow: 0 6px 18px rgba(37, 99, 235, 0.25);
  }
</style>