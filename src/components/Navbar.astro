---
// src/components/Navbar.astro
import atriaIcon from '../assets/ATRIA_icon_64px.png';
---

<header class="navbar-wrapper">
  <div class="container navbar">
    <a href="#" class="brand">
      <img src={atriaIcon.src} alt="ATRIA" class="brand-img" />
      <div class="brand-text-group">
        <span class="logo-name">ATRIA<span class="gold-dot">.</span><span class="logo-tech">TECH</span></span>
        <span class="logo-subtitle code-font">INGENIERÍA & SOFTWARE</span>
      </div>
    </a>
    
    <nav class="nav-links">
      <a href="#proyectos" class="nav-item">Proyectos</a>
      <a href="#servicios" class="nav-item">Servicios</a>
      <a href="#cotizador" class="nav-item">Cotizador</a>
      <a href="#contacto" class="btn-nav">Iniciar Proyecto</a>
    </nav>
  </div>
</header>

<style is:global>
  .navbar-wrapper {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    background: rgba(255, 255, 255, 0.92);
    border-bottom: 1px solid rgba(15, 37, 55, 0.08);
    width: 100%;
  }

  .navbar {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    padding: 0.75rem 0 !important;
  }

  .brand {
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    text-decoration: none !important;
  }

  /* LOGO CONTROLADO Y PROPORCIONADO */
  .brand-img {
    height: 32px !important;
    width: auto !important;
    max-width: 32px !important;
    object-fit: contain !important;
    display: block !important;
  }

  .brand-text-group {
    display: flex !important;
    flex-direction: column !important;
    text-align: left !important;
    line-height: 1 !important;
  }

  .logo-name {
    font-size: 1.15rem !important;
    font-weight: 900 !important;
    color: #0F2537 !important;
    letter-spacing: -0.4px !important;
    display: flex !important;
    align-items: baseline !important;
  }

  .gold-dot {
    color: #C7A96A !important;
  }

  .logo-tech {
    font-size: 0.92rem !important;
    font-weight: 700 !important;
    color: #6B7280 !important;
  }

  .logo-subtitle {
    font-size: 0.58rem !important;
    color: #9CA3AF !important;
    letter-spacing: 1.2px !important;
    font-weight: 700 !important;
    margin-top: 2px !important;
  }

  .nav-links {
    display: flex !important;
    align-items: center !important;
    gap: 2rem !important;
  }

  .nav-item {
    color: #4B5563 !important;
    text-decoration: none !important;
    font-size: 0.9rem !important;
    font-weight: 600 !important;
    transition: color 0.2s ease;
  }

  .nav-item:hover {
    color: #0F2537 !important;
  }

  .btn-nav {
    background: #0F2537 !important;
    color: #FFFFFF !important;
    text-decoration: none !important;
    padding: 0.55rem 1.25rem !important;
    border-radius: 9px !important;
    font-size: 0.85rem !important;
    font-weight: 700 !important;
    border: 1px solid rgba(199, 169, 106, 0.4) !important;
    box-shadow: 0 4px 12px rgba(15, 37, 55, 0.12) !important;
    transition: all 0.2s ease !important;
  }

  .btn-nav:hover {
    transform: translateY(-2px);
    background: #C7A96A !important;
    color: #0F2537 !important;
    border-color: #C7A96A !important;
  }
</style>