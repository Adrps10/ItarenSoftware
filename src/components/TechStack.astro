---
// src/components/TechStack.astro
const techs = [
  "Java & Spring Boot",
  "PostgreSQL & MySQL",
  "Docker & Containers",
  "Astro & SSR",
  "Vue / React",
  "REST & GraphQL APIs",
  "Microservicios",
  "AWS Cloud Infra",
  "Flutter & Dart"
];
---

<section id="stack" class="stack-marquee-wrapper">
  <div class="marquee-track">
    <div class="marquee-content">
      {techs.concat(techs).map((tech) => (
        <div class="tech-item code-font">
          <span class="tech-dot"></span>
          {tech}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stack-marquee-wrapper {
    padding: 2.2rem 0;
    overflow: hidden;
    background: #F8F9FA;
    border-top: 1px solid rgba(15, 37, 55, 0.07);
    border-bottom: 1px solid rgba(15, 37, 55, 0.07);
    position: relative;
  }

  .marquee-track {
    display: flex;
    width: max-content;
  }

  .marquee-content {
    display: flex;
    gap: 3.5rem;
    animation: scroll 30s linear infinite;
  }

  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .tech-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.88rem;
    color: #0F2537;
    white-space: nowrap;
    font-weight: 700;
    letter-spacing: -0.2px;
  }

  /* PUNTO EN DORADO ATRIA */
  .tech-dot {
    width: 7px;
    height: 7px;
    background: #C7A96A;
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(199, 169, 106, 0.6);
  }
</style>