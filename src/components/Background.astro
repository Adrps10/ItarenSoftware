---
// src/components/Background.astro
---

<div class="background-wrapper">
  <div class="grid-overlay"></div>

  <!-- Luces Aurora Stripe / Apple Clean -->
  <svg class="background--custom" viewBox="0 0 100 100" preserveAspectRatio="none">
    <defs>
      <filter id="aurora-blur-clean" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="15" result="blur" />
      </filter>
    </defs>
    <path 
      fill="#2563EB" 
      fill-opacity="0.08" 
      d="M-100 -100L200 -100L200 65L-100 65Z" 
      class="animate-path-0"
      filter="url(#aurora-blur-clean)"
    />
    <path 
      fill="#10B981" 
      fill-opacity="0.05" 
      d="M-100 -100L200 -100L200 55L-100 55Z" 
      class="animate-path-1"
      filter="url(#aurora-blur-clean)"
    />
    <path 
      fill="#E2E8F0" 
      fill-opacity="0.6" 
      d="M-100 -100L200 -100L200 45L-100 45Z" 
      class="animate-path-2"
      filter="url(#aurora-blur-clean)"
    />
  </svg>
  
  <div id="cursor-glow" class="glow-orb"></div>
</div>

<script>
  const glow = document.getElementById('cursor-glow');
  window.addEventListener('pointermove', (e) => {
    if (glow) {
      requestAnimationFrame(() => {
        glow.style.transform = `translate(${e.clientX - 300}px, ${e.clientY - 300}px)`;
      });
    }
  });
</script>

<style>
  .background-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    overflow: hidden;
    background-color: #F8FAFC;
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-size: 48px 48px;
    background-image: 
      linear-gradient(to right, rgba(15, 23, 42, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(15, 23, 42, 0.04) 1px, transparent 1px);
    mask-image: radial-gradient(circle at center, black 40%, transparent 85%);
    -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 85%);
    pointer-events: none;
    z-index: 1;
  }

  .background--custom {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  path { transform-origin: 50% 0%; }
  .animate-path-0 { animation: path0 18s ease-in-out infinite alternate; }
  .animate-path-1 { animation: path1 24s ease-in-out infinite alternate; }
  .animate-path-2 { animation: path2 30s ease-in-out infinite alternate; }

  @keyframes path0 {
    0% { transform: rotate(-6deg) scale(1.05); }
    100% { transform: rotate(6deg) scale(1.15); }
  }
  @keyframes path1 {
    0% { transform: rotate(-12deg) scale(1); }
    100% { transform: rotate(12deg) scale(1.08); }
  }
  @keyframes path2 {
    0% { transform: rotate(15deg) scale(1.02); }
    100% { transform: rotate(-15deg) scale(0.96); }
  }

  .glow-orb {
    position: fixed;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.08), rgba(16, 185, 129, 0.03) 45%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 2;
    transition: transform 0.1s ease-out;
    will-change: transform;
  }
</style>