---
// src/components/Background.astro
---

<div class="background-wrapper">
  <!-- Malla interactiva -->
  <div class="grid-overlay"></div>

  <!-- Luces Aurora dinámicas -->
  <svg class="background--custom" viewBox="0 0 100 100" preserveAspectRatio="none">
    <defs>
      <filter id="aurora-blur-premium" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="12" result="blur" />
      </filter>
    </defs>
    <path 
      fill="#06B6D4" 
      fill-opacity="0.1" 
      d="M-100 -100L200 -100L200 65L-100 65Z" 
      class="animate-path-0"
      filter="url(#aurora-blur-premium)"
    />
    <path 
      fill="#2563EB" 
      fill-opacity="0.12" 
      d="M-100 -100L200 -100L200 55L-100 55Z" 
      class="animate-path-1"
      filter="url(#aurora-blur-premium)"
    />
    <path 
      fill="#7C3AED" 
      fill-opacity="0.08" 
      d="M-100 -100L200 -100L200 45L-100 45Z" 
      class="animate-path-2"
      filter="url(#aurora-blur-premium)"
    />
  </svg>
  
  <!-- Spotlight interactivo que sigue al cursor -->
  <div id="cursor-glow" class="glow-orb"></div>
</div>

<script>
  const glow = document.getElementById('cursor-glow');
  window.addEventListener('pointermove', (e) => {
    if (glow) {
      requestAnimationFrame(() => {
        glow.style.transform = `translate(${e.clientX - 300}px, ${e.clientY - 300}px)`;
      });
    }
  });
</script>

<style>
  .background-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    overflow: hidden;
    background-color: #F1F5F9;
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-size: 50px 50px;
    background-image: 
      linear-gradient(to right, rgba(11, 19, 43, 0.05) 1.2px, transparent 1.2px),
      linear-gradient(to bottom, rgba(11, 19, 43, 0.05) 1.2px, transparent 1.2px);
    mask-image: radial-gradient(circle at center, black 30%, transparent 85%);
    -webkit-mask-image: radial-gradient(circle at center, black 30%, transparent 85%);
    pointer-events: none;
    z-index: 1;
    opacity: 0.85;
  }

  .background--custom {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.9;
  }

  path {
    transform-origin: 50% 0%;
    mix-blend-mode: multiply;
  }

  .animate-path-0 { animation: path0 15s ease-in-out infinite alternate; }
  .animate-path-1 { animation: path1 20s ease-in-out infinite alternate; }
  .animate-path-2 { animation: path2 30s ease-in-out infinite alternate; }

  @keyframes path0 {
    0% { transform: rotate(-8deg) scale(1.1); }
    100% { transform: rotate(8deg) scale(1.2); }
  }
  @keyframes path1 {
    0% { transform: rotate(-15deg) scale(1); }
    100% { transform: rotate(15deg) scale(1.1); }
  }
  @keyframes path2 {
    0% { transform: rotate(20deg) scale(1.05); }
    100% { transform: rotate(-20deg) scale(0.98); }
  }

  .glow-orb {
    position: fixed;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.08), rgba(124, 58, 237, 0.03) 50%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 2;
    transition: transform 0.1s ease-out;
    will-change: transform;
  }
</style>