---
// src/components/Contact.astro
---

<section id="contacto" class="contact-stage">
  <div class="container">
    <div class="contact-card">
      <div class="contact-header">
        <span class="badge-tag code-font">// CONTACTO DIRECTO</span>
        <h2 class="contact-title">Iniciemos la conversación</h2>
        <p class="contact-desc">Recibe una propuesta técnica y cotización formal sin compromiso.</p>
      </div>

      <form class="pro-contact-form" onsubmit="event.preventDefault(); alert('¡Mensaje enviado con éxito! En breve nos comunicaremos contigo.');">
        <div class="form-row">
          <div class="input-field">
            <label>Nombre y Apellidos</label>
            <input type="text" placeholder="Ej. Carlos Mendoza" required />
          </div>
          <div class="input-field">
            <label>Correo Electrónico Corporativo</label>
            <input type="email" placeholder="carlos@empresa.com" required />
          </div>
        </div>

        <div class="input-field">
          <label>Alcance o requerimientos del proyecto</label>
          <textarea id="contact-message" rows="5" placeholder="Describe qué procesos deseas automatizar, requerimientos de integración o tiempos de entrega..."></textarea>
        </div>

        <button type="submit" class="submit-action-btn">
          <span>Enviar Requerimientos</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
        </button>
      </form>
    </div>
  </div>
</section>

<style is:global>
  .contact-stage {
    width: 100%;
    padding: 5rem 0 8rem;
    background: transparent;
  }

  .contact-card {
    max-width: 820px;
    margin: 0 auto;
    background: #ffffff !important;
    border: 1px solid rgba(11, 19, 43, 0.1) !important;
    border-radius: 26px !important;
    padding: 3.5rem !important;
    box-shadow: 0 20px 45px -15px rgba(11, 19, 43, 0.08) !important;
  }

  @media (max-width: 768px) {
    .contact-card { padding: 2rem 1.5rem !important; }
  }

  .contact-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .badge-tag {
    display: inline-block;
    color: #06B6D4;
    font-size: 0.8rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .contact-title {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 900;
    letter-spacing: -1.2px;
    color: #0B132B;
    margin-bottom: 0.5rem;
  }

  .contact-desc {
    font-size: 1.05rem;
    color: #475569;
  }

  .pro-contact-form {
    display: flex !important;
    flex-direction: column !important;
    gap: 1.6rem !important;
  }

  .form-row {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 1.5rem !important;
  }

  @media (max-width: 650px) {
    .form-row { grid-template-columns: 1fr !important; }
  }

  .input-field {
    display: flex !important;
    flex-direction: column !important;
    gap: 0.5rem !important;
    text-align: left;
  }

  .input-field label {
    font-size: 0.85rem;
    font-weight: 800;
    color: #0B132B;
    letter-spacing: 0.2px;
  }

  .input-field input,
  .input-field textarea {
    width: 100% !important;
    box-sizing: border-box !important;
    padding: 0.95rem 1.2rem !important;
    background: #F8FAFC !important;
    border: 1.5px solid rgba(11, 19, 43, 0.1) !important;
    border-radius: 12px !important;
    color: #0B132B !important;
    font-size: 0.95rem !important;
    font-family: inherit !important;
    outline: none !important;
    transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;
  }

  .input-field input:focus,
  .input-field textarea:focus {
    background: #ffffff !important;
    border-color: #2563EB !important;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1) !important;
  }

  .submit-action-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 10px !important;
    background: #0B132B !important;
    color: #ffffff !important;
    border: none !important;
    padding: 1.1rem !important;
    border-radius: 12px !important;
    font-weight: 800 !important;
    font-size: 1rem !important;
    cursor: pointer !important;
    box-shadow: 0 10px 25px -5px rgba(11, 19, 43, 0.25) !important;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .submit-action-btn:hover {
    background: #2563EB !important;
    transform: translateY(-2px);
  }
</style>