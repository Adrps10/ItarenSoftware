---
// src/components/Estimator.astro
---

<section id="cotizador" class="estimator-stage">
  <div class="container">
    <div class="section-badge-center">
      <span class="pulse-dot"></span>
      <span>Configurador en Vivo</span>
    </div>

    <h2 class="section-headline">
      Calcula el alcance de <span class="headline-gradient">tu proyecto</span>
    </h2>
    <p class="section-subline">
      Selecciona los módulos clave para generar una cotización técnica personalizada en segundos.
    </p>

    <div class="estimator-card">
      <div class="options-matrix">
        <label class="interactive-option">
          <input type="checkbox" name="service" value="CRM & Gestión de Ventas" checked class="calc-box" />
          <div class="option-body">
            <span class="opt-title">Sistema CRM / ERP Core</span>
            <span class="opt-desc">Embudo de ventas, catálogo, cotizaciones en 1 clic y roles</span>
          </div>
        </label>

        <label class="interactive-option">
          <input type="checkbox" name="service" value="App Móvil Flutter (iOS & Android)" checked class="calc-box" />
          <div class="option-body">
            <span class="opt-title">App Móvil Flutter (iOS & Android)</span>
            <span class="opt-desc">Modo offline, notificaciones push y captura multimedia</span>
          </div>
        </label>

        <label class="interactive-option">
          <input type="checkbox" name="service" value="Punto de Venta (POS)" class="calc-box" />
          <div class="option-body">
            <span class="opt-title">Punto de Venta Transaccional</span>
            <span class="opt-desc">Control de caja, facturación, ticket térmico y corte del día</span>
          </div>
        </label>

        <label class="interactive-option">
          <input type="checkbox" name="service" value="Portal Web Showroom" class="calc-box" />
          <div class="option-body">
            <span class="opt-title">Portal Web & Showroom Digital</span>
            <span class="opt-desc">Catálogo de alta velocidad con redirección de leads a WhatsApp</span>
          </div>
        </label>

        <label class="interactive-option">
          <input type="checkbox" name="service" value="Integraciones & APIs REST" class="calc-box" />
          <div class="option-body">
            <span class="opt-title">Integraciones & Conexiones API</span>
            <span class="opt-desc">Pasarelas de pago, webhooks y sincronización ERP</span>
          </div>
        </label>

        <label class="interactive-option">
          <input type="checkbox" name="service" value="Auditoría Cloud & Bases de Datos" class="calc-box" />
          <div class="option-body">
            <span class="opt-title">Consultoría & Despliegue Cloud</span>
            <span class="opt-desc">Bases de datos en PostgreSQL, Docker y seguridad HTTPS/JWT</span>
          </div>
        </label>
      </div>

      <div class="summary-ribbon">
        <div class="summary-stats">
          <span class="sum-lbl code-font">MÓDULOS SELECCIONADOS</span>
          <span id="selected-count" class="sum-val">2 Módulos Activos</span>
        </div>
        <a href="#contacto" id="btn-prefill" class="summary-btn">
          <span>Cotizar esta configuración</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function initEstimator() {
    const checkboxes = document.querySelectorAll('.calc-box');
    const countLabel = document.getElementById('selected-count');
    const contactTextarea = document.querySelector('#contact-message');

    function updateEstimate() {
      const selected = [];
      checkboxes.forEach((cb) => {
        if (cb.checked) selected.push(cb.value);
      });

      if (countLabel) {
        countLabel.textContent = `${selected.length} ${selected.length === 1 ? 'Módulo Activo' : 'Módulos Activos'}`;
      }

      if (contactTextarea) {
        contactTextarea.value = `Hola ATRIA, me interesa cotizar una solución con los siguientes módulos: ${selected.join(', ')}.`;
      }
    }

    checkboxes.forEach((cb) => cb.addEventListener('change', updateEstimate));
    updateEstimate();
  })();
</script>

<style is:global>
  .estimator-stage {
    width: 100%;
    padding: 6rem 0 7rem;
    background: transparent;
  }

  .estimator-card {
    background: #FFFFFF !important;
    border: 1.5px solid rgba(15, 37, 55, 0.08) !important;
    border-radius: 26px !important;
    padding: 3rem !important;
    max-width: 1060px;
    margin: 0 auto;
    box-shadow: 0 15px 35px -10px rgba(15, 37, 55, 0.06) !important;
  }

  @media (max-width: 768px) {
    .estimator-card { padding: 1.8rem 1.2rem !important; }
  }

  .options-matrix {
    display: grid !important;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)) !important;
    gap: 1.4rem !important;
    margin-bottom: 2.5rem;
  }

  .interactive-option {
    display: flex !important;
    align-items: flex-start !important;
    gap: 14px;
    padding: 1.5rem !important;
    background: #F8F9FA !important;
    border: 1.5px solid rgba(15, 37, 55, 0.08) !important;
    border-radius: 18px !important;
    cursor: pointer;
    text-align: left;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .interactive-option:hover {
    border-color: #C7A96A !important;
    transform: translateY(-2px);
  }

  .interactive-option:has(input:checked) {
    background: #FFFFFF !important;
    border-color: #0F2537 !important;
    box-shadow: 0 8px 20px rgba(15, 37, 55, 0.08) !important;
  }

  .interactive-option input {
    accent-color: #0F2537;
    width: 20px;
    height: 20px;
    margin-top: 3px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .opt-title {
    display: block;
    font-size: 1rem;
    font-weight: 800;
    color: #0F2537;
    margin-bottom: 0.3rem;
  }

  .opt-desc {
    display: block;
    font-size: 0.85rem;
    color: #6B7280;
    line-height: 1.5;
  }

  .summary-ribbon {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    background: #0F2537 !important;
    padding: 1.4rem 2.2rem !important;
    border-radius: 18px !important;
    box-shadow: 0 10px 25px rgba(15, 37, 55, 0.2) !important;
  }

  @media (max-width: 700px) {
    .summary-ribbon {
      flex-direction: column !important;
      gap: 1.5rem !important;
      text-align: center !important;
      padding: 1.8rem !important;
    }
  }

  .summary-stats {
    display: flex !important;
    flex-direction: column !important;
    gap: 3px;
    text-align: left;
  }
  @media (max-width: 700px) {
    .summary-stats { text-align: center !important; }
  }

  .sum-lbl {
    font-size: 0.72rem;
    color: #9CA3AF;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .sum-val {
    font-size: 1.35rem;
    font-weight: 900;
    color: #C7A96A;
    letter-spacing: -0.5px;
  }

  /* BOTON RESUMEN DORADO ATRIA */
  .summary-btn {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px;
    background: #C7A96A !important;
    color: #0F2537 !important;
    text-decoration: none !important;
    padding: 1rem 2rem !important;
    border-radius: 12px !important;
    font-weight: 800;
    font-size: 0.95rem;
    box-shadow: 0 8px 20px rgba(199, 169, 106, 0.35) !important;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .summary-btn:hover {
    transform: translateY(-2px);
    background: #dbbe7d !important;
  }
</style>