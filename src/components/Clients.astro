---
// src/components/Clients.astro
const clientLogos = [
  { name: "Toyota Pachuca", src: "/logos/toyota.svg" },
  { name: "GWM Celaya", src: "/logos/GWM.svg" },
  { name: "ComproCars", src: "/logos/comprocars.svg" },
  { name: "Carsline", src: "/logos/carsline.svg" },
  { name: "Inmotion", src: "/logos/inmotion.svg" }
];

// Multiplicamos para asegurar un loop infinito continuo y balanceado
const fullList = [...clientLogos, ...clientLogos, ...clientLogos];
---

<section class="clients-section">
  <div class="clients-glow"></div>
  <p class="clients-title code-font">EMPRESAS Y AGENCIAS QUE CONFÍAN EN NUESTRAS SOLUCIONES</p>

  <div class="marquee-viewport" id="marquee-viewport">
    <div class="marquee-track" id="marquee-track">
      <!-- Bloque 1 -->
      <div class="marquee-group">
        {fullList.map((client) => (
          <div class="logo-item" title={client.name}>
            <img src={client.src} alt={client.name} class="logo-img" loading="lazy" />
          </div>
        ))}
      </div>
      <!-- Bloque 2 Duplicado para loop sin saltos -->
      <div class="marquee-group" aria-hidden="true">
        {fullList.map((client) => (
          <div class="logo-item" title={client.name}>
            <img src={client.src} alt={client.name} class="logo-img" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function startMarquee() {
    const track = document.getElementById('marquee-track');
    const viewport = document.getElementById('marquee-viewport');
    if (!track || !viewport) return;

    let position = 0;
    const speed = 0.65;
    let isPaused = false;

    viewport.addEventListener('mouseenter', () => (isPaused = true));
    viewport.addEventListener('mouseleave', () => (isPaused = false));

    function step() {
      if (!isPaused) {
        position += speed;
        if (position >= track.scrollWidth / 2) {
          position = 0;
        }
        track.style.transform = `translateX(-${position}px)`;
      }
      requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startMarquee);
  } else {
    startMarquee();
  }
</script>

<style>
  .clients-section {
    width: 100%;
    padding: 4rem 0 4.5rem;
    overflow: hidden;
    position: relative;
    /* Bordes sutiles oscuros (Azul noche con baja opacidad) */
    border-top: 1px solid rgba(11, 19, 43, 0.08);
    border-bottom: 1px solid rgba(11, 19, 43, 0.08);
    /* Fondo blanco puro para contraste premium */
    background: #ffffff;
  }

  /* Luz difusa central suavizada (Cian tech) */
  .clients-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60%;
    height: 100%;
    background: radial-gradient(ellipse at center, rgba(6, 182, 212, 0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .clients-title {
    text-align: center;
    font-size: 0.78rem;
    /* Gris carbón para texto secundario */
    color: #1E293B;
    letter-spacing: 2px;
    margin-bottom: 3rem;
    text-transform: uppercase;
    font-weight: 700;
  }

  .marquee-viewport {
    width: 100%;
    overflow: hidden;
    display: flex;
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 1) 15%,
      rgba(0, 0, 0, 1) 85%,
      rgba(0, 0, 0, 0) 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 1) 15%,
      rgba(0, 0, 0, 1) 85%,
      rgba(0, 0, 0, 0) 100%
    );
  }

  .marquee-track {
    display: flex;
    flex-direction: row;
    width: max-content;
    will-change: transform;
    cursor: grab;
  }

  .marquee-group {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4rem; /* Un poco más de espacio */
    padding-right: 4rem;
    flex-shrink: 0;
  }

  .logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    cursor: pointer;
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .logo-item:hover {
    transform: scale(1.06);
  }

  /* Logos: Lógica invertida para fondo claro */
  .logo-img {
    height: 40px !important; /* Ligeramente más grandes */
    width: auto !important;
    max-width: 180px !important;
    object-fit: contain;
    display: block;
    /* Gris oscuro por defecto */
    filter: brightness(0) opacity(0.6);
    transition: filter 0.3s ease, opacity 0.3s ease;
  }

  .logo-item:hover .logo-img {
    /* Negro puro o color original en hover */
    filter: brightness(0) opacity(1);
    /* Sombra suave oscura */
    drop-shadow(0 4px 6px rgba(11, 19, 43, 0.1));
  }
</style>