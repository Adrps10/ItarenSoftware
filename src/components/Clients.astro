---
// src/components/Clients.astro
const clientLogos = [
  { name: "Toyota Pachuca", src: "/logos/toyota.svg" },
  { name: "GWM Celaya", src: "/logos/GWM.svg" },
  { name: "ComproCars", src: "/logos/comprocars.svg" },
  { name: "Carsline", src: "/logos/carsline.svg" },
  { name: "Inmotion", src: "/logos/inmotion.svg" }
];

const fullList = [...clientLogos, ...clientLogos, ...clientLogos];
---

<section class="clients-section">
  <div class="clients-glow"></div>
  <p class="clients-title code-font">EMPRESAS Y AGENCIAS QUE CONFÍAN EN NUESTRAS SOLUCIONES</p>

  <div class="marquee-viewport" id="marquee-viewport">
    <div class="marquee-track" id="marquee-track">
      <div class="marquee-group">
        {fullList.map((client) => (
          <div class="logo-item" title={client.name}>
            <img src={client.src} alt={client.name} class="logo-img" loading="lazy" />
          </div>
        ))}
      </div>
      <div class="marquee-group" aria-hidden="true">
        {fullList.map((client) => (
          <div class="logo-item" title={client.name}>
            <img src={client.src} alt={client.name} class="logo-img" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function startMarquee() {
    const track = document.getElementById('marquee-track');
    const viewport = document.getElementById('marquee-viewport');
    if (!track || !viewport) return;

    let position = 0;
    const speed = 0.65;
    let isPaused = false;

    viewport.addEventListener('mouseenter', () => (isPaused = true));
    viewport.addEventListener('mouseleave', () => (isPaused = false));

    function step() {
      if (!isPaused) {
        position += speed;
        if (position >= track.scrollWidth / 2) {
          position = 0;
        }
        track.style.transform = `translateX(-${position}px)`;
      }
      requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startMarquee);
  } else {
    startMarquee();
  }
</script>

<style is:global>
  .clients-section {
    width: 100%;
    padding: 3.5rem 0 4rem;
    overflow: hidden;
    position: relative;
    border-top: 1px solid rgba(15, 37, 55, 0.07);
    border-bottom: 1px solid rgba(15, 37, 55, 0.07);
    background: transparent;
  }

  /* DESTELLO DE LUZ CALIBRADO AL DORADO ATRIA */
  .clients-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60%;
    height: 100%;
    background: radial-gradient(ellipse at center, rgba(199, 169, 106, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .clients-title {
    text-align: center;
    font-size: 0.76rem;
    color: #6B7280;
    letter-spacing: 2px;
    margin-bottom: 2.5rem;
    text-transform: uppercase;
    font-weight: 800;
  }

  .marquee-viewport {
    width: 100%;
    overflow: hidden;
    display: flex;
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 1) 15%,
      rgba(0, 0, 0, 1) 85%,
      rgba(0, 0, 0, 0) 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 1) 15%,
      rgba(0, 0, 0, 1) 85%,
      rgba(0, 0, 0, 0) 100%
    );
  }

  .marquee-track {
    display: flex;
    flex-direction: row;
    width: max-content;
    will-change: transform;
    cursor: grab;
  }

  .marquee-group {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4.5rem;
    padding-right: 4.5rem;
    flex-shrink: 0;
  }

  .logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .logo-item:hover {
    transform: scale(1.08);
  }

  .logo-img {
    height: 34px !important;
    width: auto !important;
    max-width: 150px !important;
    object-fit: contain;
    display: block;
    filter: grayscale(1) opacity(0.45);
    transition: opacity 0.25s ease, filter 0.25s ease;
  }

  .logo-item:hover .logo-img {
    filter: grayscale(0) opacity(1);
  }
</style>