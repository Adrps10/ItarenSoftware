---
// src/components/Projects.astro
const projects = [
  {
    category: "Automotriz & Concesionarios",
    tag: "Enterprise Core",
    title: "Plataforma Centralizada de CSAT & Control de Taller",
    desc: "Infraestructura analítica para agencias automotrices con captura de encuestas de satisfacción, seguimiento de citas y sincronización en tiempo real con asesores.",
    metric: "+65% captura de feedback",
    stack: ["Java / Spring Boot", "PostgreSQL", "Astro", "REST API"],
    accent: "#2563EB"
  },
  {
    category: "Mobile & Operación en Campo",
    tag: "Mobile Flutter",
    title: "App Multiplataforma de Inspección y Valuación",
    desc: "Herramienta móvil nativa para Android e iOS con modo offline total, escaneo óptico de datos, captura de evidencia fotográfica y reporte instantáneo.",
    metric: "iOS & Android (100% Nativo)",
    stack: ["Flutter", "Dart", "Firebase Push", "Offline Sync"],
    accent: "#06B6D4"
  },
  {
    category: "Retail & Comercializadoras",
    tag: "High-Speed POS",
    title: "Punto de Venta Multi-Sucursal & Inventario Cloud",
    desc: "Sistema transaccional de caja con facturación electrónica inmediata, control estricto de accesos por roles y conciliación financiera en tiempo real.",
    metric: "< 1s por transacción",
    stack: ["Docker", "Vue.js", "MySQL", "Seguridad JWT"],
    accent: "#7C3AED"
  },
  {
    category: "Portales B2B & Showrooms",
    tag: "High-Speed Web",
    title: "Showroom Digital & Cotizador de Alta Conversión",
    desc: "Portal interactivo con catálogo dinámico de inventario, conexión automatizada a WhatsApp empresarial y sincronización directa al CRM comercial.",
    metric: "100/100 Core Web Vitals",
    stack: ["Astro SSR", "TypeScript", "Tailwind CSS"],
    accent: "#2563EB"
  }
];
---

<section id="proyectos" class="projects-section">
  <div class="container">
    <div class="section-badge-center">
      <span class="pulse-dot"></span>
      <span>Casos de Éxito &bull; Entornos Productivos</span>
    </div>

    <h2 class="section-headline">
      Software probado en <span class="headline-gradient">operaciones reales</span>
    </h2>
    <p class="section-subline">
      Arquitecturas implementadas en agencias automotrices, puntos de venta y plataformas móviles con alta concurrencia.
    </p>

    <div class="projects-grid">
      {projects.map((proj) => (
        <div class="project-card">
          <div class="card-header">
            <span class="proj-category code-font">{proj.category}</span>
            <span class="proj-metric-pill code-font">{proj.metric}</span>
          </div>

          <div class="card-main">
            <span class="proj-tag-badge" style={`color: ${proj.accent}; border: 1px solid ${proj.accent}40; background-color: ${proj.accent}15;`}>
              {proj.tag}
            </span>
            <h3 class="proj-title">{proj.title}</h3>
            <p class="proj-desc">{proj.desc}</p>
          </div>

          <div class="card-bottom">
            <span class="stack-label code-font">STACK TECNOLÓGICO</span>
            <div class="stack-chips">
              {proj.stack.map((tech) => (
                <span class="tech-chip code-font">{tech}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .projects-section {
    width: 100%;
    padding: 6rem 0 7rem;
    background: transparent;
  }

  .section-badge-center {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1px solid rgba(11, 19, 43, 0.12);
    padding: 0.45rem 1.2rem;
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 700;
    color: #0B132B;
    margin: 0 auto 1.2rem;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.04);
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    background: #2563EB;
    border-radius: 50%;
  }

  .section-headline {
    text-align: center;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    font-weight: 900;
    letter-spacing: -1.5px;
    color: #0B132B;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .headline-gradient {
    background: linear-gradient(135deg, #2563EB 0%, #7C3AED 60%, #06B6D4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-subline {
    text-align: center;
    font-size: 1.1rem;
    color: #475569;
    max-width: 680px;
    margin: 0 auto 3.5rem;
    line-height: 1.6;
  }

  .projects-grid {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 2rem !important;
    text-align: left;
  }

  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: 1fr !important;
    }
  }

  .project-card {
    background: #ffffff !important;
    border: 1px solid rgba(11, 19, 43, 0.1) !important;
    border-radius: 22px !important;
    padding: 2.2rem !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    box-shadow: 0 10px 25px -5px rgba(11, 19, 43, 0.06) !important;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 35px -5px rgba(37, 99, 235, 0.12) !important;
  }

  .card-header {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    margin-bottom: 1.25rem;
    gap: 1rem;
  }

  .proj-category {
    font-size: 0.75rem;
    color: #64748B;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    font-weight: 700;
  }

  .proj-metric-pill {
    font-size: 0.75rem;
    color: #06B6D4;
    background: rgba(6, 182, 212, 0.08);
    border: 1px solid rgba(6, 182, 212, 0.25);
    padding: 3px 10px;
    border-radius: 9999px;
    font-weight: 800;
    white-space: nowrap;
  }

  .card-main {
    margin-bottom: 1.5rem;
  }

  .proj-tag-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 6px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.8rem;
  }

  .proj-title {
    font-size: 1.35rem;
    font-weight: 900;
    color: #0B132B;
    line-height: 1.3;
    letter-spacing: -0.5px;
    margin-bottom: 0.6rem;
  }

  .proj-desc {
    font-size: 0.95rem;
    color: #334155;
    line-height: 1.6;
  }

  .card-bottom {
    border-top: 1px solid rgba(11, 19, 43, 0.08);
    padding-top: 1.25rem;
  }

  .stack-label {
    display: block;
    font-size: 0.68rem;
    color: #64748B;
    font-weight: 800;
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
  }

  .stack-chips {
    display: flex !important;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tech-chip {
    font-size: 0.75rem;
    color: #1E293B;
    background: #F1F5F9;
    border: 1px solid rgba(11, 19, 43, 0.08);
    padding: 3px 9px;
    border-radius: 6px;
    font-weight: 600;
  }
</style>