---
// src/components/WhatsAppButton.astro
const phone = "525500000000";
const message = encodeURIComponent("Hola, me gustaría cotizar una solución de software con ATRIA.");
---

<aside class="wa-floating-wrapper" aria-label="Contacto directo">
  <a 
    href={`https://wa.me/${phone}?text=${message}`} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="wa-floating-btn"
    title="Chatear por WhatsApp"
  >
    <div class="wa-tooltip code-font">¿Cotización rápida? Escríbenos</div>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
    </svg>
  </a>
</aside>

<style is:global>
  .wa-floating-wrapper {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 99;
  }

  .wa-floating-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    background: #0F2537;
    color: #C7A96A !important;
    border: 1.5px solid rgba(199, 169, 106, 0.4);
    border-radius: 50%;
    box-shadow: 0 8px 24px rgba(15, 37, 55, 0.25);
    text-decoration: none !important;
    transition: all 0.25s ease;
    position: relative;
  }

  .wa-floating-btn:hover {
    transform: scale(1.08) translateY(-2px);
    background: #C7A96A;
    color: #0F2537 !important;
    box-shadow: 0 12px 28px rgba(199, 169, 106, 0.4);
  }

  .wa-tooltip {
    position: absolute;
    right: 62px;
    background: #0F2537;
    color: #FFFFFF;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translateX(8px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    border: 1px solid rgba(199, 169, 106, 0.3);
  }

  .wa-floating-btn:hover .wa-tooltip {
    opacity: 1;
    transform: translateX(0);
  }
</style>