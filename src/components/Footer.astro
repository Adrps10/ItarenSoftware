---
// src/components/Footer.astro
import atriaLogo from '../assets/ATRIA_logo_256px.png';
const year = new Date().getFullYear();
---

<footer class="apple-footer">
  <div class="container">
    <div class="footer-top">
      <div class="brand-column">
        <a href="#" class="footer-brand-link">
          <img src={atriaLogo.src} alt="ATRIA" class="footer-logo-img" />
        </a>
        <p class="brand-desc">
          Infraestructura de software de alto impacto para agencias automotrices, plataformas transaccionales y consultoría tecnológica.
        </p>
      </div>

      <div class="links-matrix">
        <div class="link-col">
          <span class="col-title code-font">SOLUCIONES</span>
          <a href="#servicios">Sistemas CRM / ERP</a>
          <a href="#servicios">Apps Móviles Flutter</a>
          <a href="#servicios">Punto de Venta (POS)</a>
          <a href="#servicios">Cloud & APIs</a>
        </div>
        <div class="link-col">
          <span class="col-title code-font">EMPRESA</span>
          <a href="#proyectos">Casos de Éxito</a>
          <a href="#cotizador">Configurador</a>
          <a href="#faq">Preguntas Frecuentes</a>
          <a href="#contacto">Contacto Directo</a>
        </div>
        <div class="link-col">
          <span class="col-title code-font">TECNOLOGÍA</span>
          <span class="tech-item">Java & Spring Boot</span>
          <span class="tech-item">PostgreSQL / Oracle</span>
          <span class="tech-item">Flutter & Dart</span>
          <span class="tech-item">Docker & AWS</span>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright code-font">
        &copy; {year} ATRIA. Todos los derechos reservados.
      </p>
      <div class="status-indicator">
        <span class="status-dot"></span>
        <span class="status-text code-font">SISTEMAS OPERATIVOS 100%</span>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  .apple-footer {
    width: 100%;
    padding: 4.5rem 0 3rem;
    background: #FFFFFF !important;
    border-top: 1px solid rgba(15, 37, 55, 0.08);
    position: relative;
    z-index: 10;
  }

  .footer-top {
    display: flex !important;
    justify-content: space-between !important;
    align-items: flex-start !important;
    gap: 4rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid rgba(15, 37, 55, 0.06);
    flex-wrap: wrap;
  }

  .brand-column {
    max-width: 360px;
    text-align: left;
  }

  .footer-brand-link {
    display: inline-block;
    margin-bottom: 1rem;
  }

  /* TAMAÑO DEL LOGO CALIBRADO */
  .footer-logo-img {
    height: 48px !important;
    width: auto !important;
    max-width: 180px !important;
    object-fit: contain !important;
    display: block !important;
  }

  .brand-desc {
    font-size: 0.9rem;
    color: #6B7280;
    line-height: 1.6;
  }

  .links-matrix {
    display: flex !important;
    gap: 3.5rem;
    flex-wrap: wrap;
    text-align: left;
  }

  .link-col {
    display: flex !important;
    flex-direction: column !important;
    gap: 0.75rem;
  }

  .col-title {
    font-size: 0.72rem;
    color: #0F2537;
    font-weight: 800;
    letter-spacing: 1px;
    margin-bottom: 0.35rem;
  }

  .link-col a {
    font-size: 0.88rem;
    color: #4B5563;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .link-col a:hover {
    color: #C7A96A;
  }

  .tech-item {
    font-size: 0.88rem;
    color: #9CA3AF;
  }

  .footer-bottom {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    padding-top: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .copyright {
    font-size: 0.78rem;
    color: #9CA3AF;
  }

  .status-indicator {
    display: inline-flex !important;
    align-items: center !important;
    gap: 7px;
    background: rgba(199, 169, 106, 0.12);
    border: 1px solid rgba(199, 169, 106, 0.3);
    padding: 4px 12px;
    border-radius: 9999px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: #C7A96A;
    border-radius: 50%;
  }

  .status-text {
    font-size: 0.68rem;
    font-weight: 800;
    color: #0F2537;
  }
</style>